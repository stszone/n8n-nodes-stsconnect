{
  "name": "n8n-nodes-stsconnect",
  "version": "0.1.0",
  "description": "n8n community nodes for STS Connect: send messages, manage conversations and contacts, and receive webhook events from the STS Connect Inbox.",
  "license": "MIT",
  "author": "Smart Telecom",
  "homepage": "https://github.com/stszone/n8n-nodes-stsconnect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stszone/n8n-nodes-stsconnect.git"
  },
  "bugs": {
    "url": "https://github.com/stszone/n8n-nodes-stsconnect/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "sts-connect",
    "messaging",
    "whatsapp"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "lint": "eslint credentials nodes test --ext .ts",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/StsConnectApi.credentials.js",
      "dist/credentials/StsConnectWebhookApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/StsConnect/StsConnect.node.js",
      "dist/nodes/StsConnectTrigger/StsConnectTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "8.57.1",
    "eslint-plugin-n8n-nodes-base": "2.0.0",
    "n8n-workflow": "1.120.31",
    "typescript": "5.9.2"
  }
}
